<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dictionary SYSTEM "file://localhost/System/Library/DTDs/sdef.dtd">
<dictionary title="Synthetic Test Suite">
    <suite name="Synthetic Suite" code="SYNT" description="Hand-crafted suite used to exercise the parser." hidden="no">
        <cocoa name="SyntheticSuite"/>
        <access-group identifier="com.example.synthetic.read" access="r"/>
        <documentation>
            <html>Top-level documentation for the synthetic suite.</html>
        </documentation>

        <command name="echo text" code="SYNTecho" id="echo-cmd" description="Returns the input text verbatim." hidden="no">
            <cocoa class="EchoHandler"/>
            <access-group identifier="com.example.synthetic.read"/>
            <synonym name="repeat text"/>
            <documentation>
                <html>Echoes the supplied text back to the caller.</html>
                <html>Optionally upper-cases the result.</html>
            </documentation>
            <parameter name="text" code="text" type="text" description="The string to echo." requires-access="r"/>
            <parameter name="upper" code="uppr" type="boolean" optional="yes" hidden="no" description="If yes, upper-case the result."/>
            <result type="text" description="The echoed string."/>
            <xref target="add-numbers"/>
        </command>

        <command name="add numbers" code="SYNTaddn" id="add-numbers">
            <direct-parameter type="real" description="First operand."/>
            <parameter name="and" code="andd" description="Second operand or list of operands.">
                <type type="real"/>
                <type type="real" list="yes"/>
            </parameter>
            <result>
                <type type="real"/>
            </result>
        </command>

        <event name="opened" code="SYNTeopn" id="opened-event" description="Fired when a synthetic document is opened.">
            <cocoa class="OpenedEventHandler"/>
            <parameter name="reference" code="dref" type="text" description="A reference to the opened document."/>
        </event>

        <enumeration name="export format" code="SYfm" description="File formats supported by the synthetic exporter." inline="2">
            <enumerator name="csv" code="cmma" description="Comma-separated values."/>
            <enumerator name="json" code="json" description="JavaScript Object Notation."/>
            <enumerator name="xml" code="xml1" description="Extensible Markup Language." hidden="yes"/>
        </enumeration>

        <record-type name="bounding box" code="SYbx" plural="bounding boxes" description="A rectangular bounding box.">
            <property name="left" code="left" type="real" description="Left edge."/>
            <property name="top" code="topp" type="real" description="Top edge."/>
            <property name="right" code="rght" type="real" description="Right edge."/>
            <property name="bottom" code="botm" type="real" access="r" in-properties="no" description="Bottom edge (read-only, not in `properties of`)."/>
        </record-type>

        <value-type name="color" code="SYcl" description="An RGB color value.">
            <cocoa class="NSColor"/>
            <synonym name="colour"/>
        </value-type>

        <class name="shape" code="SYsh" plural="shapes" description="Base type for all 2D shapes.">
            <cocoa class="SyntheticShape"/>
            <property name="name" code="pnam" type="text" access="r" description="Identifier of the shape."/>
        </class>

        <class name="rectangle" code="SYrc" inherits="shape" plural="rectangles" description="A rectangle on the canvas.">
            <cocoa class="SyntheticRectangle"/>
            <type type="shape"/>
            <property name="width" code="wdth" type="real" description="Width in points."/>
            <property name="height" code="hght" type="real" description="Height in points.">
                <cocoa key="heightInPoints"/>
            </property>
            <element type="point" access="r">
                <cocoa key="anchorPoints"/>
                <accessor style="index"/>
                <accessor style="id"/>
            </element>
            <contents name="content" code="pcnt" type="text" description="Implied text contents."/>
            <responds-to command="rotate">
                <cocoa method="rotateBy:"/>
            </responds-to>
        </class>

        <class-extension extends="rectangle" title="Annotations" description="Adds annotation support to rectangles." id="rect-annotations">
            <property name="label" code="labl" type="text" description="A free-form label."/>
        </class-extension>
    </suite>
</dictionary>
